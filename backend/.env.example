# =========================================
# ShopNex Backend Environment Config
# Copy this to ".env" and fill real values
# =========================================

NODE_ENV=development
PORT=5000

# MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/shopnex

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# AWS S3 (Product Images) - optional, falls back to local disk storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# Admin seed credentials (used by npm run seed)
SEED_ADMIN_EMAIL=admin@shopnex.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=User@123
